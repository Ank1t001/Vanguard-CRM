# Copy to .env for running setup locally. Add the same values in
# Vercel > Project > Settings > Environment Variables.

# The "Vanguard - All Leads" spreadsheet ID (the long code in its URL)
SHEET_ID=

# Service account from Google Cloud. Share the sheet with this email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key file, keeping the \n sequences, in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# OAuth web client ID for "Sign in with Google"
GOOGLE_CLIENT_ID=

# Make webhook for email events (optional; can also go in the CRM Settings tab)
MAKE_WEBHOOK_URL=

# Any long random string. Vercel uses it to authorise the daily job.
CRON_SECRET=

# Minutes of inactivity before staff are signed out (default 30)
IDLE_MINUTES=30
